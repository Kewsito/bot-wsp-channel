---
// src/pages/index.astro
import './src/styles/global.css';
---
<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Operativos SJ</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <style>
    /* Solo lo que Tailwind no puede hacer: animación pulse del dot y altura de Leaflet */
    @keyframes pulse-ring {
      0%, 100% { transform: scale(1); opacity: .25; }
      50%       { transform: scale(1.7); opacity: 0; }
    }
    .pulse-ring::after {
      content: '';
      position: absolute;
      inset: -4px;
      border-radius: 9999px;
      background: #ef4444;
      opacity: .25;
      animation: pulse-ring 2s ease-in-out infinite;
    }
    #map { width: 100%; height: calc(100vh - 52px); }
    @media (max-width: 640px) { #map { height: 55vh; } }
  </style>
</head>
<body class="h-full bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans">

  <div class="grid h-screen" style="grid-template-rows: 52px 1fr;">

    <!-- HEADER -->
    <header class="flex items-center justify-between px-5 bg-slate-900 dark:bg-slate-950 border-b border-white/10 gap-3">
      <div class="flex items-center gap-3">
        <!-- Dot animado -->
        <span class="relative shrink-0 w-2.5 h-2.5">
          <span class="pulse-ring absolute inset-0 rounded-full bg-red-500"></span>
          <span class="relative block w-2.5 h-2.5 rounded-full bg-red-500"></span>
        </span>
        <h1 class="text-sm font-semibold tracking-tight text-white">Operativos de tránsito</h1>
        <span class="text-xs text-white/40 hidden sm:inline">San Juan, Argentina</span>
      </div>
      <div class="flex items-center gap-2.5">
        <span id="badge" class="text-[11px] font-medium px-2.5 py-0.5 rounded-full border border-white text-red-500 bg-red-50">
          EN VIVO 
        </span>
        <span id="counter" class="text-xs text-white/50 hidden sm:inline">3 activos</span>
        <button
          id="refresh-btn"
          class="flex items-center gap-1.5 text-xs text-white/60 hover:text-white border border-white/15 hover:border-white/30 rounded-lg px-2.5 py-1.5 transition-all duration-150 hover:bg-white/5 cursor-pointer"
        >
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>
          </svg>
          Actualizar
        </button>
      </div>
    </header>

    <!-- BODY -->
    <div class="grid overflow-hidden" style="grid-template-columns: 1fr 272px;">

      <!-- MAPA -->
      <div id="map"></div>

      <!-- SIDEBAR -->
      <aside class="flex flex-col border-l border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">

        <!-- Stats -->
        <div class="grid grid-cols-2 divide-x divide-slate-200 dark:divide-slate-800 border-b border-slate-200 dark:border-slate-800">
          <div class="p-4">
            <p class="text-[14px] text-slate-400 dark:text-slate-200 mb-1">Activos</p>
            <p id="stat-total" class="text-2xl font-semibold tracking-tight text-white">3</p>
          </div>
          <div class="p-4">
            <p class="text-[14px] text-slate-400 dark:text-slate-200 mb-1">Actualizado</p>
            <p id="stat-time" class="text-sm font-medium pt-1 text-white">—</p>
          </div>
        </div>

        <!-- Lista header -->
        <div class="px-4 py-2.5 text-[11px] font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500 border-b border-slate-200 dark:border-slate-800 shrink-0">
          Operativos detectados
        </div>

        <!-- Lista -->
        <div id="list" class="flex-1 overflow-y-auto">
          <div class="p-4 text-sm text-center text-slate-400">Cargando...</div>
        </div>

        <!-- Footer -->
        <div class="px-4 py-2 text-[10px] text-slate-400 dark:text-slate-600 border-t border-slate-200 dark:border-slate-800 shrink-0">
          Version 1.0.0
          <a href="www.github.com/Kewsito" target="_blank"> Github</a>
        </div>

      </aside>
    </div>
  </div>

  <script is:inline src="/scripts/frontend.js"></script>
</body>
</html>